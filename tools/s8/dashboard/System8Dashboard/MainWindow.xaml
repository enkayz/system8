<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="System8Dashboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:System8Dashboard.Core.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:System8Dashboard"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="System 8"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="WideWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ToolListColumn.Width" Value="320" />
                        <Setter Target="ToolDetailsPanel.Margin" Value="24,0,0,0" />
                        <Setter Target="ShellNavigation.PaneDisplayMode" Value="Auto" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ToolListColumn.Width" Value="230" />
                        <Setter Target="ToolDetailsPanel.Margin" Value="12,0,0,0" />
                        <Setter Target="ShellNavigation.PaneDisplayMode" Value="LeftCompact" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            x:Uid="AppTitleBar"
            AutomationProperties.AutomationId="AppTitleBar">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="ShellNavigation"
            x:Uid="ShellNavigation"
            Grid.Row="1"
            AutomationProperties.AutomationId="ShellNavigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Auto"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="OverviewNavigation" Icon="Home" Tag="overview" />
                <NavigationViewItem x:Uid="ToolsNavigation" Icon="AllApps" Tag="tools" />
                <NavigationViewItem x:Uid="RequestsNavigation" Icon="Permissions" Tag="requests" />
                <NavigationViewItem x:Uid="SettingsNavigation" Icon="Setting" Tag="settings" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="SupportNavigation" Icon="Help" Tag="support" />
            </NavigationView.FooterMenuItems>

            <Grid Padding="24,16,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="StatusBar"
                    x:Uid="StatusBar"
                    AutomationProperties.AutomationId="StatusBar"
                    IsClosable="False"
                    IsOpen="True"
                    Message="{x:Bind ViewModel.Status, Mode=OneWay}"
                    Severity="Informational" />

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <ScrollViewer x:Name="OverviewPage" x:Uid="OverviewPage">
                        <StackPanel MaxWidth="1100" HorizontalAlignment="Left" Spacing="18">
                            <TextBlock x:Uid="WelcomeHeading" Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock x:Uid="WelcomeBody" MaxWidth="820" TextWrapping="WrapWholeWords" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Tools, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><ItemsWrapGrid MaximumRowsOrColumns="3" Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:ToolDefinition">
                                        <Border Width="300" MinHeight="126" Margin="0,0,12,12" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                            <StackPanel Spacing="7">
                                                <TextBlock Text="{x:Bind Name}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind Description}" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="WrapWholeWords" />
                                                <TextBlock Text="{x:Bind Availability}" Style="{ThemeResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="ToolsPage" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition x:Name="ToolListColumn" Width="320" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ListView
                            x:Name="ToolsList"
                            x:Uid="ToolsList"
                            AutomationProperties.AutomationId="ToolsList"
                            ItemsSource="{x:Bind ViewModel.Tools, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedTool, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:ToolDefinition">
                                    <StackPanel Padding="4" Spacing="4">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Availability}" Style="{ThemeResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid x:Name="ToolDetailsPanel" Grid.Column="1" Margin="24,0,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <CommandBar DefaultLabelPosition="Right">
                                <AppBarButton x:Name="InstallButton" x:Uid="InstallButton" AutomationProperties.AutomationId="InstallButton" Icon="Download" Click="OnInstallClicked" />
                                <AppBarSeparator />
                                <AppBarButton x:Name="RunButton" x:Uid="RunButton" AutomationProperties.AutomationId="RunButton" Icon="Play" IsEnabled="{x:Bind ViewModel.SelectedTool.IsInstalled, Mode=OneWay}" Click="OnRunClicked" />
                                <AppBarButton x:Name="RefreshButton" x:Uid="RefreshButton" AutomationProperties.AutomationId="RefreshButton" Icon="Refresh" Click="OnRefreshClicked" />
                                <AppBarButton x:Name="EvidenceButton" x:Uid="EvidenceButton" AutomationProperties.AutomationId="EvidenceButton" Icon="OpenFile" Click="OnOpenEvidenceClicked" />
                            </CommandBar>
                            <TextBox x:Name="ArgumentsBox" x:Uid="ArgumentsBox" Grid.Row="1" AutomationProperties.AutomationId="ArgumentsBox" Text="{x:Bind ViewModel.Arguments, Mode=TwoWay}" />
                            <Grid Grid.Row="2" Margin="0,14,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBox x:Name="ResultBox" x:Uid="ResultBox" AutomationProperties.AutomationId="ResultBox" AcceptsReturn="True" IsReadOnly="True" Text="{x:Bind ViewModel.ResultText, Mode=OneWay}" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                <Button x:Name="RequestFromRunButton" x:Uid="RequestFromRunButton" Grid.Row="1" AutomationProperties.AutomationId="RequestFromRunButton" HorizontalAlignment="Right" Margin="0,12,0,0" IsEnabled="{x:Bind ViewModel.HasAccessGaps, Mode=OneWay}" Click="OnRequestAccessClicked" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <ScrollViewer x:Name="RequestsPage" Visibility="Collapsed">
                        <StackPanel MaxWidth="820" HorizontalAlignment="Left" Spacing="14">
                            <TextBlock x:Uid="RequestsHeading" Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock x:Uid="RequestsBody" TextWrapping="WrapWholeWords" />
                            <TextBox x:Name="AdministratorEmailBox" x:Uid="AdministratorEmailBox" AutomationProperties.AutomationId="AdministratorEmailBox" Text="{x:Bind ViewModel.AdministratorEmail, Mode=TwoWay}" />
                            <CommandBar DefaultLabelPosition="Right">
                                <AppBarButton x:Name="PrepareRequestButton" x:Uid="PrepareRequestButton" AutomationProperties.AutomationId="PrepareRequestButton" Icon="Mail" IsEnabled="{x:Bind ViewModel.HasAccessGaps, Mode=OneWay}" Click="OnRequestAccessClicked" />
                                <AppBarButton x:Name="CheckPimButton" x:Uid="CheckPimButton" AutomationProperties.AutomationId="CheckPimButton" Icon="Permissions" IsEnabled="{x:Bind ViewModel.HasAccessGaps, Mode=OneWay}" Click="OnCheckPimClicked" />
                            </CommandBar>
                            <TextBox x:Name="RequestBodyBox" x:Uid="RequestBodyBox" AutomationProperties.AutomationId="RequestBodyBox" AcceptsReturn="True" IsReadOnly="True" MinHeight="260" Text="{x:Bind ViewModel.AccessRequestBody, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed">
                        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="18">
                            <TextBlock x:Uid="SettingsHeading" Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock x:Uid="SettingsBody" TextWrapping="WrapWholeWords" />
                            <ComboBox x:Name="ThemeSelector" x:Uid="ThemeSelector" AutomationProperties.AutomationId="ThemeSelector" SelectionChanged="OnThemeChanged">
                                <ComboBoxItem x:Uid="ThemeSystem" Tag="Default" />
                                <ComboBoxItem x:Uid="ThemeLight" Tag="Light" />
                                <ComboBoxItem x:Uid="ThemeDark" Tag="Dark" />
                            </ComboBox>
                            <Border MaxWidth="680" Padding="18" HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                <StackPanel Spacing="7">
                                    <TextBlock x:Uid="ToolchainHeading" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Uid="ToolchainBody" TextWrapping="WrapWholeWords" />
                                    <TextBlock Text="{x:Bind ViewModel.ToolchainSummary}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.ToolchainPath}" FontFamily="Consolas" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Button x:Name="SupportButton" x:Uid="SupportButton" AutomationProperties.AutomationId="SupportButton" HorizontalAlignment="Left" Click="OnSupportClicked" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
